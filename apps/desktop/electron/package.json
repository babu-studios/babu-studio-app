{
  "name": "@babu-studios/electron",
  "version": "0.1.1",
  "private": true,
  "description": "Electron desktop shell for Babu Studio.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "44.8.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "studio.babu.app",
    "productName": "Babu Studio",
    "directories": {
      "output": "../../../release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../../core/build/bundle",
        "to": "media-core"
      }
    ],
    "mac": {
      "identity": "-",
      "artifactName": "Babu-Studio-${arch}.${ext}",
      "hardenedRuntime": false,
      "category": "public.app-category.video",
      "extendInfo": {
        "NSCameraUsageDescription": "Babu Studio uses camera access to show connected cameras and capture cards in your scene preview.",
        "NSMicrophoneUsageDescription": "Babu Studio uses microphone access to list and capture your selected audio input."
      }
    }
  }
}
